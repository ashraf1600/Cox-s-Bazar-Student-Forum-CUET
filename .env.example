# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production (set these on your host, with DJANGO_DEBUG=False) ---
# DJANGO_ALLOWED_HOSTS=your-app.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# DJANGO_SERVE_MEDIA=True          # only if DJANGO_MEDIA_ROOT is on a persistent disk
# DJANGO_MEDIA_ROOT=/var/data/media

# --- Email for approval notifications (optional) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=CSF-CUET <you@gmail.com>
